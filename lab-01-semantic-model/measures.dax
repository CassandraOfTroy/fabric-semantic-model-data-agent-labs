//
//    /// Net sales from 1 January to the last date in the current filter context.
//    MEASURE 'Sales'[Net Sales YTD] = TOTALYTD ( [Net Sales], 'Date'[date] )
//
// Expected: Net Sales YoY % for 2025 = 10.0 %
